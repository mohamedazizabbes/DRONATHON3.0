<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skyforge_ros</name>
  <version>0.1.0</version>
  <description>SKYFORGE ROS 2 Jazzy nodes: orchestrator, perception agent, reflex/vehicle, comm, monitors, fault injector, vision template.</description>
  <maintainer email="team@skyforge.local">SKYFORGE team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>skyforge_interfaces</exec_depend>
  <exec_depend>skyforge_core</exec_depend>
  <!-- optional at runtime: px4_msgs (backend:=px4), ultralytics (vision_node) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
