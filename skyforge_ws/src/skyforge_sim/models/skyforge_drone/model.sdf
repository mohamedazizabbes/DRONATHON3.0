<?xml version="1.0"?>
<sdf version="1.9">
<model name="skyforge_drone">
  <link name="base_link">
    <gravity>false</gravity>
    <inertial><mass>2.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <collision name="c"><pose>0 0 0.06 0 0 0</pose><geometry><box><size>0.5 0.5 0.12</size></box></geometry></collision>
    <visual name="body"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.24 0.18 0.08</size></box></geometry>
      <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
    <visual name="arm1"><pose>0 0 0.08 0 0 0.7854</pose><geometry><box><size>0.62 0.03 0.02</size></box></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <visual name="arm2"><pose>0 0 0.08 0 0 -0.7854</pose><geometry><box><size>0.62 0.03 0.02</size></box></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <visual name="r1"><pose>0.22 0.22 0.11 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
      <material><ambient>0.85 0.4 0.1 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual>
    <visual name="r2"><pose>-0.22 0.22 0.11 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
      <material><ambient>0.85 0.4 0.1 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual>
    <visual name="r3"><pose>0.22 -0.22 0.11 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
      <material><ambient>0.85 0.4 0.1 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual>
    <visual name="r4"><pose>-0.22 -0.22 0.11 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
      <material><ambient>0.85 0.4 0.1 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual>
    <visual name="gimbal"><pose>0.08 0 0.02 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry>
      <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    <sensor name="rgb" type="camera">
      <pose>0.08 0 -0.02 0 1.2217 0</pose>
      <topic>/cam/rgb</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <camera>
        <camera_info_topic>/cam/rgb/camera_info</camera_info_topic>
        <horizontal_fov>1.3963</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.2</near><far>400</far></clip>
      </camera>
    </sensor>
    <sensor name="thermal" type="thermal_camera">
      <pose>0.08 0 -0.02 0 1.2217 0</pose>
      <topic>/cam/thermal</topic>
      <update_rate>5</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov>
        <image><width>320</width><height>240</height><format>L16</format></image>
        <clip><near>0.2</near><far>400</far></clip>
      </camera>
      <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp><max_temp>673.15</max_temp><resolution>0.01</resolution>
      </plugin>
    </sensor>
  </link>
  <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <dimensions>3</dimensions>
    <odom_frame>map</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
  </plugin>
</model>
</sdf>
