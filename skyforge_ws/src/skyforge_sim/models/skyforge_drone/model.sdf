<?xml version="1.0"?>
<sdf version="1.9">
<model name="skyforge_drone">
  <link name="base_link">
    <gravity>false</gravity>
    <inertial><mass>2.0</mass><inertia><ixx>0.3</ixx><iyy>0.1</iyy><izz>0.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <collision name="c"><geometry><box><size>1.1 3.2 0.15</size></box></geometry></collision>
    <visual name="fuselage"><geometry><mesh><uri>meshes/fuselage.stl</uri></mesh></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.93 0.94 0.95 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
    <visual name="wings"><geometry><mesh><uri>meshes/wings.stl</uri></mesh></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.8 0.82 0.86 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
    <visual name="tips"><geometry><mesh><uri>meshes/tips.stl</uri></mesh></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.95 0.42 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
    <visual name="tail"><geometry><mesh><uri>meshes/tail.stl</uri></mesh></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.95 0.42 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
    <visual name="motors"><geometry><mesh><uri>meshes/motors.stl</uri></mesh></geometry><material><ambient>0.08 0.08 0.1 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
    <visual name="gimbal"><pose>0.35 0 -0.09 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
    <visual name="nav_red"><pose>0.33 1.66 0.05 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material></visual>
    <visual name="nav_green"><pose>0.33 -1.66 0.05 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual>
    <sensor name="rgb" type="camera">
      <pose>0.35 0 -0.13 0 1.2217 0</pose>
      <topic>/cam/rgb</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <camera>
        <camera_info_topic>/cam/rgb/camera_info</camera_info_topic>
        <horizontal_fov>1.3963</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.2</near><far>400</far></clip>
      </camera>
    </sensor>
    <sensor name="thermal" type="thermal_camera">
      <pose>0.35 0 -0.13 0 1.2217 0</pose>
      <topic>/cam/thermal</topic>
      <update_rate>5</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov>
        <image><width>320</width><height>240</height><format>L16</format></image>
        <clip><near>0.2</near><far>400</far></clip>
      </camera>
      <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp><max_temp>673.15</max_temp><resolution>0.01</resolution>
      </plugin>
    </sensor>
  </link>
  <link name="prop1"><pose>-0.2964 0.0 0.0741 0 0 0</pose><gravity>false</gravity>
    <inertial><mass>0.02</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="v"><geometry><mesh><uri>meshes/prop1.stl</uri></mesh></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
  </link>
  <joint name="prop1_joint" type="revolute"><parent>base_link</parent><child>prop1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>prop1_joint</joint_name><initial_velocity>45</initial_velocity></plugin>
  <link name="prop3"><pose>0.3094 0.64 -0.0072 0 0 0</pose><gravity>false</gravity>
    <inertial><mass>0.02</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="v"><geometry><mesh><uri>meshes/prop3.stl</uri></mesh></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
  </link>
  <joint name="prop3_joint" type="revolute"><parent>base_link</parent><child>prop3</child><axis><xyz>-1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>prop3_joint</joint_name><initial_velocity>-45</initial_velocity></plugin>
  <link name="prop4"><pose>0.3093 -0.64 -0.0068 0 0 0</pose><gravity>false</gravity>
    <inertial><mass>0.02</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="v"><geometry><mesh><uri>meshes/prop4.stl</uri></mesh></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
  </link>
  <joint name="prop4_joint" type="revolute"><parent>base_link</parent><child>prop4</child><axis><xyz>-1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>prop4_joint</joint_name><initial_velocity>-45</initial_velocity></plugin>
  <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <dimensions>3</dimensions>
    <odom_frame>map</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
  </plugin>
</model>
</sdf>
