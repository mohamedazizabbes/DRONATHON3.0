<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skyforge_bringup</name>
  <version>0.1.0</version>
  <description>SKYFORGE launch files and the single parameter file (skyforge.yaml).</description>
  <maintainer email="team@skyforge.local">SKYFORGE team</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>skyforge_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
